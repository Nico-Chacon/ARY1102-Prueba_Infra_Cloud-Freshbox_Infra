# NO se versiona el Secret real. deploy-k8s.sh lo crea desde los secrets de GitHub:
#   kubectl -n freshbox create secret generic freshbox-secret \
#     --from-literal=DB_USER=admin --from-literal=DB_PASS='<password>'
apiVersion: v1
kind: Secret
metadata:
  name: freshbox-secret
  namespace: freshbox
type: Opaque
stringData:
  DB_USER: admin
  DB_PASS: "<password>"
